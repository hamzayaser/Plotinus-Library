# Bu dosyayı .env.local olarak kopyala ve gerçek değerleri gir.
# .env.local GİT'E YÜKLENMEZ (.gitignore içinde).

# Supabase Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Settings > API > "anon" / "publishable" key (tarayıcıda görünmesi güvenlidir)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_BK5RgE7VTgdnux-RE-g2Nw_vaZcwZXR

# Supabase Settings > API > "service_role" / "secret" key
# ASLA NEXT_PUBLIC_ ile başlatma, ASLA client tarafında kullanma, ASLA git'e ekleme.
SUPABASE_SERVICE_KEY=SUPABASE_SERVICE_KEY=buraya_key_gelecek

# Admin panel şifresi (kendin belirle, güçlü bir şifre seç)
ADMIN_PASSWORD=degistir-bunu-guclu-bir-sifreyle
